# Server
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
APP_VERSION=1.3.0

# CORS
# Use your Vercel URL in production, for example:
# ALLOWED_ORIGINS=https://drone-doctor.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Database
# Leave DATABASE_URL empty for local SQLite fallback.
# Railway production should provide a PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@host:5432/dronedoctor
# SQLITE_PATH=../data/dronedoctor.db

# AI providers
QWEN_API_KEY=your_qwen_api_key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus

KIMI_API_KEY=your_kimi_api_key
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key

XIAOMI_API_KEY=your_xiaomi_api_key
XIAOMI_API_BASE=https://token-plan-cn.xiaomimimo.com
XIAOMI_VISION_MODEL=your_xiaomi_vision_model
