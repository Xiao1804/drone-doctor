# Server
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
APP_VERSION=1.3.0

# CORS
# Use your Vercel URL in production, for example:
# ALLOWED_ORIGINS=https://drone-doctor.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Database
# Leave DATABASE_URL empty for local SQLite fallback.
# Railway production should provide a PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@host:5432/dronedoctor
# SQLITE_PATH=../data/dronedoctor.db

# AI providers
# DeepSeek handles text diagnosis and intent parsing.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Vision (图片识别) — 阿里云 DashScope Qwen 视觉模型，OpenAI 兼容格式调用
VISION_API_KEY=your_dashscope_api_key
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus
