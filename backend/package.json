{
  "name": "drone-doctor-backend",
  "version": "1.0.0",
  "description": "DroneDoctor Backend API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "migrate": "node-pg-migrate --envPath ../.env.tencent --migrations-dir migrations up",
    "migrate:dev": "node-pg-migrate --migrations-dir migrations up",
    "migrate:make": "node-pg-migrate --migrations-dir migrations create",
    "migrate:undo": "node-pg-migrate --envPath ../.env.tencent --migrations-dir migrations down",
    "migrate:mark-baseline": "node migrations/mark-baseline-applied.js",
    "migrate:status": "node-pg-migrate --envPath ../.env.tencent --migrations-dir migrations status"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.11.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "protobufjs": "^8.6.4"
  },
  "keywords": [
    "drone",
    "diagnosis",
    "ai",
    "api"
  ],
  "author": "Boss",
  "license": "MIT"
}
